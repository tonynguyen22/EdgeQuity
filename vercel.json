{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/sec-api/:path*",
      "destination": "https://www.sec.gov/:path*"
    },
    {
      "source": "/edgar-search/:path*",
      "destination": "https://efts.sec.gov/:path*"
    },
    {
      "source": "/edgar-facts/:path*",
      "destination": "https://data.sec.gov/:path*"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
